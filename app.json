{
  "expo": {
    "name": "Teto",
    "slug": "teto-drone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "teto",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/teto.icon",
      "bundleIdentifier": "app.teto.drone",
      "supportsTablet": false,
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.teto.drone",
      "adaptiveIcon": {
        "backgroundColor": "#113396",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#113396",
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B0C10",
            "image": "./assets/images/splash-mark-dark.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Teto uses your location to show flying conditions exactly where you are and nearby airports."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F6BFF"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.teto.drone",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "TetoCondicoes",
              "displayName": "Flying conditions",
              "description": "Flight score, wind and the next good window where you fly.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              },
              "android": {
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "minWidth": 180,
                "minHeight": 110,
                "resizeMode": "both"
              }
            },
            {
              "name": "TetoBloqueio",
              "displayName": "Flying on the Lock Screen",
              "description": "Score and wind right on your Lock Screen.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              },
              "android": null
            }
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "pt-BR",
              "en",
              "es"
            ],
            "android": [
              "pt-BR",
              "en",
              "es"
            ]
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "pt-BR": "./locales/pt-BR.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "owner": "gwin14",
    "extra": {
      "eas": {
        "projectId": "592fff13-f080-40f6-b965-8fd8e0595595"
      }
    }
  }
}
