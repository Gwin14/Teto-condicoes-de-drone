{
  "expo": {
    "name": "Teto",
    "slug": "teto-drone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "teto",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/teto.icon",
      "bundleIdentifier": "app.teto.drone",
      "supportsTablet": false,
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.teto.drone",
      "adaptiveIcon": {
        "backgroundColor": "#113396",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Teto usa sua localização para mostrar as condições de voo exatamente onde você está e os aeródromos próximos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F6BFF"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.teto.drone",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "TetoCondicoes",
              "displayName": "Condições de voo",
              "description": "Score de voo, vento e a próxima janela ideal no lugar onde você voa.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ],
                "contentMarginsDisabled": true
              },
              "android": {
                "targetCellWidth": 3,
                "targetCellHeight": 2,
                "minWidth": 180,
                "minHeight": 110,
                "resizeMode": "both"
              }
            },
            {
              "name": "TetoBloqueio",
              "displayName": "Voo na tela bloqueada",
              "description": "Score e vento direto na tela bloqueada.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              },
              "android": null
            }
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "pt-BR",
              "en",
              "es"
            ],
            "android": [
              "pt-BR",
              "en",
              "es"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "pt-BR": "./locales/pt-BR.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    }
  }
}
